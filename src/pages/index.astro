---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFeaturedCard from '../components/HomeFeaturedCard.astro';
import HomeRecentRow from '../components/HomeRecentRow.astro';
import HomeStatsStrip from '../components/HomeStatsStrip.astro';
import { getFeaturedMarketplaces, getRecentlyGoneMarketplaces, getStats } from '../lib/data';
const featured = getFeaturedMarketplaces();
const recent = getRecentlyGoneMarketplaces();
const stats = getStats();
const shelf = [
  ['Active', 'Currently operating marketplace records', '/encyclopedia/?status=active', '✽'],
  ['Inactive', 'Paused, dormant, or partially dimmed records', '/encyclopedia/?status=inactive', '⌛'],
  ['Dead', 'Permanently closed or inaccessible records', '/encyclopedia/?status=dead', '☙'],
  ['Rebranded / Merged', 'Markets that changed identity or destination', '/encyclopedia/', '🦋'],
  ['By Chain', 'Explore the archive by blockchain scope', '/encyclopedia/', '⛓'],
  ['By Category', 'Sort art, games, PFPs, and more', '/encyclopedia/', '▤'],
  ['Timeline', 'Follow marketplace history over time', '/stats/', '◷']
];
const timeline = [
  ['2017', 'Early experiments'], ['2018', 'The spark'], ['2019', 'First wave'], ['2020', 'The boom'], ['2021', 'Peak activity'], ['2022', 'Consolidation'], ['2023', 'Correction'], ['2024', 'A new chapter']
];
---
<BaseLayout title="Minted & Gone — NFT marketplace field guide">
  <div class="shell home-page-shell">
    <section class="home-mock-hero">
      <figure class="home-hero-plant" aria-hidden="true">
        <img src="/assets/home/hero-plant.png" alt="" loading="eager" />
      </figure>
      <div class="home-hero-copy">
        <p class="eyebrow">NFT marketplace archive</p>
        <h1>Minted &amp; Gone</h1>
        <div class="flourish" aria-hidden="true">✦</div>
        <p class="lede">A field guide to NFT marketplaces — living, fading, and gone.</p>
        <p>We document the stories of NFT marketplaces across time: active, closed, acquired, rebranded, and forgotten. An open archive for collectors, researchers, and the curious.</p>
        <div class="hero-actions"><a class="btn primary" href="/encyclopedia/">Browse the encyclopedia</a><a class="btn" href="/methodology/">Read methodology</a></div>
      </div>
      <aside class="home-hero-cabinet-image" aria-label="Archive cabinet illustration">
        <img src="/assets/home/hero-cabinet.png" alt="Vintage archive cabinet illustration" loading="eager" />
      </aside>
    </section>

    <section class="shelf-section framed-panel">
      <p class="eyebrow">Browse the encyclopedia</p>
      <div class="browse-shelf">{shelf.map(([title, copy, href, icon]) => <a class="shelf-card" href={href}><span class="shelf-icon">{icon}</span><strong>{title}</strong><small>{copy}</small><em>→</em></a>)}</div>
    </section>

    <section class="home-split">
      <div class="framed-panel featured-panel">
        <div class="section-head home-compact-head"><p class="eyebrow">Featured marketplaces</p><a class="text-link" href="/encyclopedia/">View all active →</a></div>
        <div class="home-featured-grid">{featured.slice(0, 4).map((record) => <HomeFeaturedCard record={record} />)}</div>
      </div>
      <aside class="framed-panel recent-panel">
        <div class="section-head home-compact-head"><p class="eyebrow">Recently gone / updated</p><a class="text-link" href="/encyclopedia/">View all →</a></div>
        <div class="home-recent-list">{recent.slice(0, 5).map((record) => <HomeRecentRow record={record} />)}</div>
      </aside>
    </section>

    <section class="timeline-strip framed-panel">
      <div class="section-head home-compact-head"><p class="eyebrow">Marketplace timeline</p><a class="text-link" href="/stats/">Explore full timeline →</a></div>
      <div class="era-line">{timeline.map(([year, label]) => <div class="era"><span></span><strong>{year}</strong><em>{label}</em></div>)}</div>
    </section>

    <section class="home-bottom">
      <div class="framed-panel glance-panel"><p class="eyebrow">Archive at a glance</p><HomeStatsStrip stats={stats} /></div>
      <article class="framed-panel about-card"><p class="eyebrow">About this archive</p><h2>Not a trading dashboard</h2><p>Minted &amp; Gone preserves marketplace histories, status changes, evidence notes, and what remains after platforms fade, close, merge, or change identity.</p><p class="subtle">Source-reviewed draft archive. Records remain open to correction.</p><a class="text-link" href="/about/">Learn more about the methodology →</a></article>
    </section>
  </div>
</BaseLayout>
