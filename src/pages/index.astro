---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketplaceCard from '../components/MarketplaceCard.astro';
import StatsKpiGrid from '../components/StatsKpiGrid.astro';
import StatusChip from '../components/StatusChip.astro';
import { getMarketplaces, getRecentlyGoneMarketplaces, getStats } from '../lib/data';
const preferredFeaturedSlugs = ['opensea', 'blur', 'magic-eden', 'teia'];
const marketplaces = getMarketplaces();
const featured = preferredFeaturedSlugs
  .map((slug) => marketplaces.find((record) => record.slug === slug))
  .filter(Boolean);
const recent = getRecentlyGoneMarketplaces();
const stats = getStats();
const shelf = [
  ['Active', 'Currently operating marketplace records', '/marketplaces/?status=active', 'active'],
  ['Inactive', 'Paused, dormant, or partially dimmed records', '/marketplaces/?status=inactive', 'inactive'],
  ['Dead', 'Permanently closed or inaccessible records', '/marketplaces/?status=dead', 'dead'],
  ['Rebranded / Merged', 'Markets that changed identity or destination', '/marketplaces/', 'merged'],
  ['By Chain', 'Explore the archive by blockchain scope', '/marketplaces/', 'chain'],
  ['By Category', 'Sort art, games, PFPs, and more', '/marketplaces/', 'category'],
  ['Timeline', 'Follow marketplace history over time', '/stats/', 'timeline']
];
const drawers = ['ACTIVE', 'INACTIVE', 'DEAD', 'MERGED', 'BY CHAIN', 'BY CATEGORY'];
const timeline = [
  ['2017', 'Early experiments'], ['2018', 'The spark'], ['2019', 'First wave'], ['2020', 'The boom'], ['2021', 'Peak activity'], ['2022', 'Consolidation'], ['2023', 'Correction'], ['2024', 'A new chapter']
];
---
<BaseLayout title="Minted & Gone — NFT marketplace field guide">
  <div class="shell">
    <section class="field-hero home-hero">
      <div class="hero-botanical botanical-plate" aria-hidden="true">
        <span class="stem stem-main"></span><span class="stem stem-side-a"></span><span class="stem stem-side-b"></span>
        <span class="leaf leaf-a"></span><span class="leaf leaf-b"></span><span class="leaf leaf-c"></span><span class="leaf leaf-d"></span><span class="leaf leaf-e"></span><span class="leaf leaf-f"></span>
        <span class="bud bud-a"></span><span class="bud bud-b"></span><span class="bud bud-c"></span>
      </div>
      <div class="hero-copy plate-copy">
        <p class="eyebrow">NFT marketplace archive</p>
        <h1>Minted &amp; Gone</h1>
        <div class="flourish" aria-hidden="true">✦</div>
        <p class="lede">A field guide to NFT marketplaces — living, fading, and gone.</p>
        <p>We document the stories of NFT marketplaces across time: active, closed, acquired, rebranded, and forgotten. An open archive for collectors, researchers, and the curious.</p>
        <div class="hero-actions"><a class="btn primary" href="/marketplaces/">Browse the encyclopedia</a><a class="btn" href="/methodology/">Read methodology</a></div>
      </div>
      <aside class="hero-plate home-field-notes framed-plate">
        <div class="archive-cabinet" aria-label="Field Notes archive cabinet">
          <div class="cabinet-top"><span></span><span></span><span></span></div>
          <div class="cabinet-drawers">{drawers.map((label) => <span class="cabinet-drawer"><b>{label}</b><i></i></span>)}</div>
          <div class="cabinet-base"><span></span></div>
        </div>
        <div class="field-note-card">
          <p class="script">Field Notes</p>
          <p>Markets come and go.<br />The record remains.</p>
          <span class="field-butterfly" aria-hidden="true">◇</span>
          <strong class="mg-stamp">M&amp;G</strong>
        </div>
      </aside>
    </section>

    <p class="mock-note">Prototype warning: all current records are mock layout records, not verified canonical marketplace claims.</p>

    <section class="shelf-section framed-panel">
      <p class="eyebrow">Browse the encyclopedia</p>
      <div class="browse-shelf">{shelf.map(([title, copy, href, icon]) => <a class="shelf-card" href={href}><span class:list={['shelf-illustration', `shelf-${icon}`]} aria-hidden="true"><i></i></span><strong>{title}</strong><small>{copy}</small><em>→</em></a>)}</div>
    </section>

    <section class="home-split">
      <div class="framed-panel home-featured-panel">
        <div class="section-head"><div><p class="eyebrow">Featured marketplaces</p><h2>Specimens from the shelf</h2></div><a class="text-link" href="/marketplaces/">View all active →</a></div>
        <div class="grid cards featured-grid home-featured-grid">{featured.slice(0, 4).map((record) => <MarketplaceCard record={record} compact home />)}</div>
      </div>
      <aside class="framed-panel recent-panel">
        <div class="section-head"><div><p class="eyebrow">Recently gone / updated</p></div><a class="text-link" href="/marketplaces/">View all →</a></div>
        <div class="recent-list">{recent.slice(0, 5).map((record) => <a class="recent-row" href={`/marketplace/${record.slug}/`}><span class="mini-mark">{record.canonical_name.slice(0,2)}</span><span><strong>{record.canonical_name}</strong><small>{record.summary}</small></span><StatusChip status={record.status} /></a>)}</div>
      </aside>
    </section>

    <section class="timeline-strip framed-panel">
      <div class="section-head"><div><p class="eyebrow">Marketplace timeline</p></div><a class="text-link" href="/stats/">Explore full timeline →</a></div>
      <div class="era-line">{timeline.map(([year, label]) => <div class="era"><span></span><strong>{year}</strong><em>{label}</em></div>)}</div>
    </section>

    <section class="home-bottom">
      <div class="framed-panel glance-panel"><p class="eyebrow">Archive at a glance</p><StatsKpiGrid stats={stats} /></div>
      <article class="framed-panel about-card"><p class="eyebrow">About this archive</p><h2>Not a trading dashboard</h2><p>Minted &amp; Gone records historical availability, evidence quality, and what remains after marketplaces change. It intentionally avoids price widgets, wallet connection, rankings, and investment framing.</p><a class="text-link" href="/about/">Learn more about the methodology →</a></article>
    </section>
  </div>
</BaseLayout>
