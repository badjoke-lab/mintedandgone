---
import BaseLayout from '../../layouts/BaseLayout.astro';

const plannedGuides = [
  {
    title: 'What happens when an NFT marketplace shuts down?',
    href: '/guides/what-happens-when-nft-marketplace-shuts-down/',
    status: 'Planned v0 guide',
    summary: 'Explains what may happen to the marketplace frontend, collection pages, trading history, metadata visibility, and archive trail when a marketplace closes or fades.'
  },
  {
    title: 'Frontend vs smart contract: what actually remains?',
    href: '/guides/frontend-vs-smart-contract-what-remains/',
    status: 'Planned v0 guide',
    summary: 'Separates the public website, marketplace UI, smart contracts, metadata, wallet visibility, and third-party marketplace paths so readers do not overread closure language.'
  }
];

const futureGuides = [
  'How to check old NFT marketplace pages',
  'Do NFTs disappear when a marketplace closes?',
  'What is an NFT marketplace aggregator?',
  'What is an NFT launchpad marketplace?'
];
---
<BaseLayout title="Guides — Minted & Gone" description="Short field-guide explainers for reading NFT marketplace history without overclaiming what disappeared or remained.">
  <div class="shell guide-page guides-index-page">
    <section class="field-hero simple-hero compact-hero">
      <div class="hero-copy plate-copy">
        <p class="eyebrow">Field-guide notes</p>
        <h1>Guides</h1>
        <div class="flourish" aria-hidden="true">✦</div>
        <p class="lede">Short explainers for reading NFT marketplace history.</p>
        <p>These guides support the encyclopedia. They explain shutdowns, archives, frontends, contracts, metadata, and continuity signals without turning Minted &amp; Gone into a general NFT blog.</p>
        <div class="hero-actions"><a class="btn primary" href="/encyclopedia/">Browse the encyclopedia</a><a class="btn" href="/methodology/">Read methodology</a></div>
      </div>
    </section>

    <p class="mock-note">Guides are registry-support pages. They do not determine asset ownership, market safety, investment value, or legal status.</p>

    <section class="guide-grid">
      {plannedGuides.map((guide) => (
        <article class="framed-panel guide-card">
          <p class="eyebrow">{guide.status}</p>
          <h2><a class="text-link" href={guide.href}>{guide.title}</a></h2>
          <p>{guide.summary}</p>
          <a class="btn" href={guide.href}>Open guide →</a>
        </article>
      ))}
    </section>

    <section class="framed-panel definition-card">
      <p class="eyebrow">How to read these guides</p>
      <h2>They explain uncertainty instead of hiding it</h2>
      <p>NFT marketplace history is uneven. A domain can disappear while archived pages remain. A marketplace frontend can close while contracts or wallet-visible assets remain readable elsewhere. Minted &amp; Gone uses guides to explain those differences before readers inspect individual records.</p>
      <div class="reading-guide-grid" aria-label="Guide principles">
        <article><strong>What may be gone</strong><span>Frontend, listings, collection pages, search, account surfaces, or original domains.</span></article>
        <article><strong>What may remain</strong><span>Contracts, metadata, wallet visibility, third-party marketplace paths, archives, or community forks.</span></article>
        <article><strong>What remains uncertain</strong><span>Asset handling, successor paths, exact dates, and current frontend behavior may need more source review.</span></article>
      </div>
    </section>

    <section class="framed-panel definition-card">
      <p class="eyebrow">Later guide candidates</p>
      <h2>v0.5 expansion</h2>
      <ul class="plain-list">
        {futureGuides.map((item) => <li>{item}</li>)}
      </ul>
      <p class="subtle">These are deferred until the two core v0 guides and the glossary/update entry points are in place.</p>
    </section>
  </div>
</BaseLayout>
