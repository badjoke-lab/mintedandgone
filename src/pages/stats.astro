---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsKpiGrid from '../components/StatsKpiGrid.astro';
import StatsBreakdown from '../components/StatsBreakdown.astro';
import { getStats } from '../lib/data';
const stats = getStats();
---
<BaseLayout title="Stats appendix — Minted & Gone">
  <div class="shell appendix-page">
    <section class="field-hero appendix-hero"><div class="hero-botanical" aria-hidden="true">✤</div><div class="hero-copy plate-copy"><p class="eyebrow">Field-guide appendix</p><h1>Archive counts</h1><div class="flourish" aria-hidden="true">✦</div><p class="lede">Static counts generated from prototype JSON.</p><p>These figures summarize mixed prototype coverage, seed-validation progress, and classification quality; they are not live market analytics, rankings, uptime monitoring, or price data.</p></div></section>
    <p class="mock-note">Prototype-data warning: these generated numbers combine mock layout records and reviewed seed-validation records. They are not final verified market history.</p>
    <section class="framed-panel stats-glance"><p class="eyebrow">Archive at a glance</p><StatsKpiGrid stats={stats} /></section>
    <section class="appendix-grid"><StatsBreakdown title="Status specimens" data={stats.breakdowns.by_status} /><StatsBreakdown title="Category drawer" data={stats.breakdowns.by_category} /><StatsBreakdown title="Marketplace scope" data={stats.breakdowns.by_marketplace_scope} /><StatsBreakdown title="Chain shelf" data={stats.breakdowns.by_chain} /><StatsBreakdown title="Confidence labels" data={stats.breakdowns.by_confidence} /><StatsBreakdown title="Review state" data={stats.breakdowns.by_review_status} /></section>
    <section class="appendix-grid two"><StatsBreakdown title="Launch-year field notes" data={stats.distributions.launch_year} /><StatsBreakdown title="End-year field notes" data={stats.distributions.end_year} /></section>
    <section class="framed-panel definition-card"><p class="eyebrow">Coverage / quality</p><h2>How to read these figures</h2><p>Archive coverage, confidence, review state, and record-quality flags are data-quality hints. They are designed to keep uncertain records visibly uncertain.</p><p class="subtle">Generated at {stats.generated_at}. Source counts: {stats.source.marketplaces_count} marketplaces, {stats.source.events_count} events, {stats.source.evidence_count} evidence notes.</p><a class="btn" href="/methodology/">Read methodology</a></section>
  </div>
</BaseLayout>