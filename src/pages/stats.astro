---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsKpiGrid from '../components/StatsKpiGrid.astro';
import StatsBreakdown from '../components/StatsBreakdown.astro';
import StatsComposition from '../components/StatsComposition.astro';
import StatsHistogram from '../components/StatsHistogram.astro';
import StatsMetricTable from '../components/StatsMetricTable.astro';
import { getStats } from '../lib/data';

const stats = getStats();
const pct = (value: number) => `${Math.round((value ?? 0) * 100)}%`;
const status = stats.breakdowns.by_status ?? {};
const flags = stats.quality?.record_quality_flags ?? {};
const flagTotal = Object.values(flags).reduce((sum: number, value: any) => sum + Number(value || 0), 0);
const activeSide = { active: status.active ?? 0, limited: status.limited ?? 0 };
const fadedSide = { inactive: status.inactive ?? 0, dead: status.dead ?? 0, rebranded: status.rebranded ?? 0, acquired: status.acquired ?? 0, merged: status.merged ?? 0 };
const populationSides = { active_side: stats.kpis.active_side_total ?? 0, faded_side: stats.kpis.faded_side_total ?? 0, unknown: stats.kpis.unknown_total ?? 0 };
const topFlags = Object.fromEntries(Object.entries(flags).sort((a, b) => Number(b[1]) - Number(a[1])).slice(0, 8));
const coverageRows = [
  ['Archive coverage', `${pct(stats.kpis.archive_coverage)} · ${stats.coverage.archive_coverage.count}/${stats.coverage.archive_coverage.total}`, 'Records with an archived URL present.'],
  ['Source-reviewed drafts', `${stats.kpis.source_reviewed_draft_total} · ${pct(stats.kpis.source_reviewed_draft_share)}`, 'Canonical public drafts with source review; not final public-quality certification.'],
  ['Public-quality reviewed', `${stats.kpis.public_quality_reviewed_total} · ${pct(stats.kpis.public_quality_reviewed_share)}`, 'Records that have completed the stricter public-quality review state.'],
  ['Records with open flags', `${stats.kpis.records_with_open_flags} · ${pct(stats.kpis.open_flag_share)}`, 'Canonical records that still expose unresolved review work.'],
  ['Evidence depth', `${stats.quality.evidence_depth.multiple ?? 0} with multiple sources`, 'How many records have more than one evidence note.'],
  ['Quality flags', flagTotal, 'Total open review flags; one record may carry multiple flags.'],
  ['Generated from', `${stats.source.marketplaces_count} records`, `${stats.source.events_count} events and ${stats.source.evidence_count} evidence notes.`]
];
---
<BaseLayout title="Stats appendix — Minted & Gone" description={`Canonical MAG statistics generated from ${stats.source.marketplaces_count} marketplaces, ${stats.source.events_count} events, and ${stats.source.evidence_count} evidence notes.`}>
  <div class="shell appendix-page stats-page">
    <section class="field-hero appendix-hero">
      <figure class="hero-botanical hero-page-art" aria-hidden="true"><img src="/assets/stats/stats-counting-rod-chart.png" alt="" loading="eager" /></figure>
      <div class="hero-copy plate-copy"><p class="eyebrow">Field-guide appendix</p><h1>Archive counts</h1><div class="flourish" aria-hidden="true">✦</div><p class="lede">Static counts generated from the canonical registry records.</p><p>These figures summarize registry coverage, exclusive status counts, chain coverage, marketplace scope, and review-quality signals. They are not live market analytics, rankings, uptime monitoring, or price data.</p></div>
    </section>
    <p class="mock-note">Review-state note: <code>reviewed_staging</code> means a source-reviewed canonical draft, not final public-quality certification. Open work remains visible in <code>record_quality_flags</code>.</p>
    <section class="framed-panel stats-glance"><p class="eyebrow">Archive at a glance</p><StatsKpiGrid stats={stats} /></section>
    <section class="stats-section-title"><p class="eyebrow">Core analysis</p><h2>What the archive looks like now</h2></section>
    <section class="stats-analysis-grid core"><StatsBreakdown title="Exclusive status breakdown" data={stats.breakdowns.by_status} limit={8} note="Each marketplace has one status; these values sum to the marketplace total." /><StatsComposition title="Active-side, faded-side, and unknown" data={populationSides} note="These three groups are mutually exclusive and sum to the total." /><StatsComposition title="Active-side status mix" data={activeSide} note="Active-side is active + limited." /><StatsComposition title="Faded-side status mix" data={fadedSide} note="Faded-side is inactive + dead + rebranded + acquired + merged. Dead and transitioned are subgroups, not extra records." /></section>
    <section class="stats-section-title"><p class="eyebrow">Breakdowns</p><h2>Where the records cluster</h2></section>
    <section class="stats-analysis-grid wide"><StatsBreakdown title="Category leaders" data={stats.breakdowns.by_category} limit={10} note="Category is single-valued in the current schema." /><StatsBreakdown title="Marketplace scope" data={stats.breakdowns.by_marketplace_scope} limit={9} note="Marketplace scope is single-valued." /><StatsBreakdown title="Chain leaders" data={stats.breakdowns.by_chain} limit={12} note="Chain scope is multi-valued, so chain totals can exceed the marketplace total." /><StatsMetricTable title="Coverage & quality" rows={coverageRows} note="Coverage and review states are shown as exact values." /></section>
    <section class="stats-section-title"><p class="eyebrow">Registry timelines</p><h2>Launch and end-year distributions</h2></section>
    <section class="stats-analysis-grid two"><StatsHistogram title="Launch-year distribution" data={stats.distributions.launch_year} note="Yearly counts are shown as a column distribution." /><StatsHistogram title="End-year distribution" data={stats.distributions.end_year} note="Unknown-heavy data stays visible without pretending it is a normal ranking." /></section>
    <section class="stats-section-title"><p class="eyebrow">Deep quality notes</p><h2>Review signals</h2></section>
    <section class="stats-analysis-grid deep"><StatsBreakdown title="Top review-quality flags" data={topFlags} limit={8} note="A record may carry multiple open flags." /><StatsComposition title="Evidence depth" data={stats.quality.evidence_depth} /><StatsComposition title="Confidence labels" data={stats.breakdowns.by_confidence} /><StatsComposition title="Machine-readable review state" data={stats.breakdowns.by_review_status} /></section>
    <section class="framed-panel definition-card stats-reading-guide"><p class="eyebrow">Coverage / quality</p><h2>How to read these figures</h2><div class="reading-guide-grid" aria-label="How to read archive statistics"><article><strong>Counts are canonical records.</strong><span>They show archive coverage, not market rank or traffic.</span></article><article><strong>Source review is not public-quality completion.</strong><span>The fixed review state and open flags remain machine-readable.</span></article><article><strong>Multi-value fields can overlap.</strong><span>Chain and platform-role totals may exceed the marketplace total.</span></article></div><p class="source-summary">Generated from {stats.source.marketplaces_count} marketplaces, {stats.source.events_count} events, and {stats.source.evidence_count} evidence notes.</p><div class="hero-actions"><a class="btn" href="/methodology/">Read methodology</a><a class="btn" href="/data/manifest.json">Open data manifest</a></div></section>
  </div>
</BaseLayout>
