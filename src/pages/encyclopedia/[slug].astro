---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusChip from '../../components/StatusChip.astro';
import Tags from '../../components/Tags.astro';
import FactGrid from '../../components/FactGrid.astro';
import WhatRemainsBlock from '../../components/WhatRemainsBlock.astro';
import UrlArchiveBlock from '../../components/UrlArchiveBlock.astro';
import Timeline from '../../components/Timeline.astro';
import EvidenceList from '../../components/EvidenceList.astro';
import MarketplaceCard from '../../components/MarketplaceCard.astro';
import { getMarketplaces, getEventsForMarketplace, getEvidenceForMarketplace, getRelatedMarketplaces } from '../../lib/data';
import { formatCategory, formatYearRange } from '../../lib/format';
export function getStaticPaths() { return getMarketplaces().map((record) => ({ params: { slug: record.slug }, props: { record } })); }
const { record } = Astro.props;
const events = getEventsForMarketplace(record.id);
const evidence = getEvidenceForMarketplace(record.id);
const related = getRelatedMarketplaces(record);
const isSeedValidation = record.review_status === 'reviewed_staging';
const archiveLabel = record.archived_url ? (record.archived_url.includes('/web/*/') ? 'Archive search available' : 'Archived capture linked') : 'Archive missing';
---
<BaseLayout title={`${record.canonical_name} — Minted & Gone`} description={record.summary}>
  <div class="shell">
    <section class="field-hero record-detail-hero">
      <div class="specimen-plate large" aria-hidden="true">◉</div>
      <div class="hero-copy plate-copy">
        <nav class="breadcrumb"><a href="/encyclopedia/">Encyclopedia</a> › {record.canonical_name}</nav>
        <div class="title-row"><h1>{record.canonical_name}</h1><StatusChip status={record.status} /></div>
        <p class="lede">{record.summary}</p>
        <p>{record.notes}</p><Tags items={[record.category, record.marketplace_scope, ...record.chain_scope]} />
      </div>
      <aside class="hero-plate framed-plate"><div class="cabinet-illustration" aria-hidden="true"><span>▤</span><span>▤</span><span>▤</span><span>▤</span><span>▤</span><span>▤</span></div><div class="field-note-stamp"><p class="script">Field Notes</p><p>Even when the lights go out, the record remains.</p><strong>M&amp;G</strong></div></aside>
    </section>
    {isSeedValidation ? <p class="mock-note">Seed validation record. Sources have been added, but this record still needs final public-quality review.</p> : <p class="mock-note">Mock record only. Verify sources before canonical public use.</p>}
    <div class="record-layout">
      <aside class="record-sidebar">
        <section class="framed-panel glance-card"><p class="eyebrow">Record at a glance</p><dl class="notes-list"><div><dt>Status</dt><dd><StatusChip status={record.status} /></dd></div><div><dt>Years active</dt><dd>{formatYearRange(record)}</dd></div><div><dt>Chain</dt><dd>{record.chain_scope.join(', ')}</dd></div><div><dt>Category</dt><dd>{formatCategory(record.category)}</dd></div><div><dt>Archive state</dt><dd>{archiveLabel}</dd></div><div><dt>What remains</dt><dd>{record.what_remains || 'Unknown in this mock record.'}</dd></div></dl><a class="btn primary wide" href="/submit/">Suggest correction →</a></section>
        <aside class="framed-panel quote-card"><p>Markets come and go.<br /><strong>The record remains.</strong></p><small>— Minted &amp; Gone Archive</small></aside>
      </aside>
      <main class="record-main">
        <section class="framed-panel overview-card"><p class="eyebrow">Overview</p><h2>Classification notes</h2><p>{record.summary}</p><p>The record below separates frontend state, contracts, assets, evidence, and archive links so uncertainty stays visible.</p><FactGrid record={record} /></section>
        <WhatRemainsBlock record={record} />
        <Timeline events={events} />
        <EvidenceList evidence={evidence} isSeedValidation={isSeedValidation} />
        <UrlArchiveBlock record={record} />
      </main>
    </div>
    <section class="framed-panel related-shelf"><div class="section-head"><div><p class="eyebrow">Related records</p></div><a class="text-link" href="/encyclopedia/">View all records →</a></div><div class="grid cards related-grid">{related.map((item) => <MarketplaceCard record={item} compact />)}</div></section>
  </div>
</BaseLayout>