---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EncyclopediaCard from '../../components/EncyclopediaCard.astro';
import StatusChip from '../../components/StatusChip.astro';
import { getMarketplaces } from '../../lib/data';
import { getFilterOptions } from '../../lib/filters';
import { formatCategory, formatLabel, formatYearRange } from '../../lib/format';
const records = getMarketplaces();
const options = getFilterOptions(records);
const selected = records.find((record) => record.slug === 'x2y2') ?? records.find((record) => record.status === 'dead') ?? records[0];
const countBy = (items, getValue) => items.reduce((acc, item) => {
  const values = Array.isArray(getValue(item)) ? getValue(item) : [getValue(item)];
  values.filter(Boolean).forEach((value) => { acc[value] = (acc[value] ?? 0) + 1; });
  return acc;
}, {});
const counts = {
  status: countBy(records, (record) => record.status),
  chain: countBy(records, (record) => record.chain_scope),
  category: countBy(records, (record) => record.category),
};
---
<BaseLayout title="Browse the Encyclopedia — Minted & Gone">
  <div class="shell encyclopedia-shell">
    <section class="field-hero encyclopedia-hero encyclopedia-hero-v2">
      <div class="hero-botanical mushroom" aria-hidden="true">♧</div>
      <div class="hero-copy plate-copy">
        <p class="eyebrow">Browse the encyclopedia</p>
        <h1>Browse the Encyclopedia</h1>
        <div class="flourish" aria-hidden="true">✦</div>
        <p class="lede">Explore the growing archive of NFT marketplaces.</p>
        <p>Search, filter, and learn about the platforms that shaped the NFT era — from early pioneers to the ones that faded, evolved, or merged.</p>
      </div>
      <aside class="hero-plate encyclopedia-hero-plate is-image" aria-label="Archive cabinet illustration">
        <img class="hero-archive-image" src="/assets/minted-gone-archive-cabinet-hero.png" alt="" loading="eager" decoding="async" />
      </aside>
    </section>
    <p class="mock-note">Draft-data warning: records are source-reviewed staging entries, not final public-quality certification. Uncertain records remain visibly flagged for later review.</p>
    <div class="market-layout encyclopedia-layout" data-filter-root>
      <aside class="filter-panel framed-panel encyclopedia-filter">
        <details open><summary><strong>Filters</strong><span class="filter-summary-hint">Search / refine</span></summary>
          <label for="market-search" class="eyebrow">Search</label><input class="search" id="market-search" data-search-input placeholder="Search encyclopedia..." />
          {[['Status','status',options.statuses],['Chain','chain',options.chains],['Category','category',options.categories]].map(([label,name,items]: any) => <fieldset class="filter-group"><legend>{label}</legend>{items.map((item:string) => <label class="check"><input type="checkbox" data-filter={name} value={item}/><span>{formatLabel(item)}</span><em>{counts[name]?.[item] ?? 0}</em></label>)}</fieldset>)}
          <button class="btn" data-clear-filters type="button">Clear filters</button>
        </details>
      </aside>
      <section class="catalog-panel framed-panel encyclopedia-catalog">
        <div class="catalog-toolbar encyclopedia-toolbar"><p><strong data-result-count>{records.length}</strong> results</p><div class="filter-pills"><span>Status: All ×</span><span>Chain: All ×</span><span>Category: All ×</span></div><a class="text-link" href="/encyclopedia/">Clear all</a><span class="view-icons" aria-hidden="true">▦ ☰</span></div>
        <div class="grid cards catalog-grid encyclopedia-grid" data-card-list>{records.map((record) => <EncyclopediaCard record={record} />)}</div>
        <div class="card empty" data-empty-state><h3>No matching records</h3><p>Clear filters or try a broader search.</p></div>
      </section>
      <aside class="field-notes-panel framed-panel encyclopedia-notes">
        <p class="eyebrow">Field notes</p><h2>{selected.canonical_name}</h2><p>{selected.summary}</p>
        <div class="specimen-plate" aria-hidden="true">◉</div>
        <dl class="notes-list"><div><dt>Status</dt><dd><StatusChip status={selected.status} /></dd></div><div><dt>Years active</dt><dd>{formatYearRange(selected)}</dd></div><div><dt>Chain</dt><dd>{selected.chain_scope.join(', ')}</dd></div><div><dt>Category</dt><dd>{formatCategory(selected.category)}</dd></div><div><dt>Archive state</dt><dd>{selected.archived_url ? 'Archive present' : 'Record remains'}</dd></div></dl>
        <a class="btn primary wide" href={`/encyclopedia/${selected.slug}/`}>View full record →</a>
        <blockquote>Even when the lights go out, the record remains.</blockquote>
      </aside>
    </div>
  </div>
  <script>
    const root = document.querySelector('[data-filter-root]');
    if (root) {
      const filterDetails = root.querySelector('.encyclopedia-filter details');
      if (filterDetails && window.matchMedia('(max-width: 720px)').matches) {
        filterDetails.removeAttribute('open');
      }
      const input = root.querySelector('[data-search-input]');
      const checks = [...root.querySelectorAll('input[type="checkbox"][data-filter]')];
      const cards = [...root.querySelectorAll('.marketplace-card')];
      const count = root.querySelector('[data-result-count]');
      const empty = root.querySelector('[data-empty-state]');
      const update = () => {
        const q = input.value.trim().toLowerCase();
        const selected = { status: [], category: [], chain: [] };
        checks.filter(c => c.checked).forEach(c => selected[c.dataset.filter].push(c.value));
        let visible = 0;
        cards.forEach(card => {
          const chains = card.dataset.chains.split('|');
          const show = (!q || card.dataset.search.includes(q)) && (!selected.status.length || selected.status.includes(card.dataset.status)) && (!selected.category.length || selected.category.includes(card.dataset.category)) && (!selected.chain.length || chains.some(c => selected.chain.includes(c)));
          card.classList.toggle('is-hidden', !show); if (show) visible++;
        });
        count.textContent = visible; empty.style.display = visible ? 'none' : 'block';
      };
      input.addEventListener('input', update); checks.forEach(c => c.addEventListener('change', update));
      root.querySelector('[data-clear-filters]').addEventListener('click', () => { input.value=''; checks.forEach(c => c.checked=false); update(); });
    }
  </script>
</BaseLayout>
