---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EncyclopediaCard from '../../components/EncyclopediaCard.astro';
import StatusChip from '../../components/StatusChip.astro';
import { getMarketplaces, getEvents, getEvidence } from '../../lib/data';
import { getFilterOptions } from '../../lib/filters';
import { formatCategory, formatLabel, formatYearRange } from '../../lib/format';

const records = getMarketplaces();
const events = getEvents();
const evidence = getEvidence();
const options = getFilterOptions(records);
const selected = records.find((record) => record.slug === 'x2y2') ?? records.find((record) => record.status === 'dead') ?? records[0];

const eventsByMarketplace = new Map();
for (const event of events) {
  const items = eventsByMarketplace.get(event.marketplace_id) ?? [];
  items.push(event);
  eventsByMarketplace.set(event.marketplace_id, items);
}

const evidenceByMarketplace = new Map();
for (const item of evidence) {
  const items = evidenceByMarketplace.get(item.marketplace_id) ?? [];
  items.push(item);
  evidenceByMarketplace.set(item.marketplace_id, items);
}

const getFilterMeta = (record) => {
  const linkedEvents = eventsByMarketplace.get(record.id) ?? [];
  const linkedEvidence = evidenceByMarketplace.get(record.id) ?? [];
  const lifecycle = [];
  if (record.successor_marketplace) lifecycle.push('has_successor');
  if (record.predecessor_marketplace) lifecycle.push('has_predecessor');
  if (linkedEvents.some((event) => event.event_type === 'asset_migration_announced')) lifecycle.push('migration_event');

  const evidenceFlags = [];
  if (record.archived_url || linkedEvidence.some((item) => item.archived_url)) evidenceFlags.push('archive_available');
  if (linkedEvidence.some((item) => item.reliability === 'high')) evidenceFlags.push('high_reliability_evidence');
  if ((record.record_quality_flags ?? []).length > 0) evidenceFlags.push('open_review_flags');

  return { lifecycle, evidenceFlags };
};

const metaById = new Map(records.map((record) => [record.id, getFilterMeta(record)]));
const countBy = (items, getValue) => items.reduce((acc, item) => {
  const values = Array.isArray(getValue(item)) ? getValue(item) : [getValue(item)];
  values.filter(Boolean).forEach((value) => { acc[value] = (acc[value] ?? 0) + 1; });
  return acc;
}, {});

const counts = {
  status: countBy(records, (record) => record.status),
  chain: countBy(records, (record) => record.chain_scope),
  category: countBy(records, (record) => record.category),
  closure_reason: countBy(records, (record) => record.closure_reason || 'unknown'),
  lifecycle: countBy(records, (record) => metaById.get(record.id)?.lifecycle ?? []),
  evidence: countBy(records, (record) => metaById.get(record.id)?.evidenceFlags ?? [])
};

const lifecycleOptions = [
  ['has_successor', 'Successor recorded'],
  ['has_predecessor', 'Predecessor recorded'],
  ['migration_event', 'Migration event recorded']
].filter(([value]) => (counts.lifecycle[value] ?? 0) > 0);

const evidenceOptions = [
  ['archive_available', 'Archive available'],
  ['high_reliability_evidence', 'High-reliability evidence'],
  ['open_review_flags', 'Open review flags']
].filter(([value]) => (counts.evidence[value] ?? 0) > 0);
---
<BaseLayout title="Browse the Encyclopedia — Minted & Gone">
  <div class="shell encyclopedia-shell">
    <section class="field-hero encyclopedia-hero encyclopedia-hero-v2">
      <div class="hero-botanical mushroom" aria-hidden="true">♧</div>
      <div class="hero-copy plate-copy">
        <p class="eyebrow">Browse the encyclopedia</p>
        <h1>Browse the Encyclopedia</h1>
        <div class="flourish" aria-hidden="true">✦</div>
        <p class="lede">Explore the growing archive of NFT marketplaces.</p>
        <p>Search, filter, and learn about the platforms that shaped the NFT era — from early pioneers to the ones that faded, evolved, or merged.</p>
      </div>
      <aside class="hero-plate encyclopedia-hero-plate is-image" aria-label="Archive cabinet illustration">
        <img class="hero-archive-image" src="/assets/minted-gone-archive-cabinet-hero.png" alt="" loading="eager" decoding="async" />
      </aside>
    </section>
    <p class="mock-note">Draft-data warning: records are source-reviewed staging entries, not final public-quality certification. Uncertain records remain visibly flagged for later review.</p>
    <div class="market-layout encyclopedia-layout" data-filter-root>
      <aside class="filter-panel framed-panel encyclopedia-filter">
        <details data-filter-details>
          <summary><strong>Search & filters</strong><span class="filter-summary-hint">Tap to refine results</span></summary>
          <label for="market-search" class="eyebrow">Search</label>
          <input class="search" id="market-search" data-search-input placeholder="Search encyclopedia..." />

          {[['Status','status',options.statuses],['Chain','chain',options.chains],['Category','category',options.categories]].map(([label,name,items]: any) =>
            <fieldset class="filter-group">
              <legend>{label}</legend>
              {items.map((item:string) => <label class="check"><input type="checkbox" data-filter={name} value={item}/><span>{formatLabel(item)}</span><em>{counts[name]?.[item] ?? 0}</em></label>)}
            </fieldset>
          )}

          {options.closureReasons.length > 0 &&
            <fieldset class="filter-group">
              <legend>Closure / change reason</legend>
              {options.closureReasons.map((item:string) => <label class="check"><input type="checkbox" data-filter="closure_reason" value={item}/><span>{formatLabel(item)}</span><em>{counts.closure_reason[item] ?? 0}</em></label>)}
            </fieldset>
          }

          <fieldset class="filter-group">
            <legend>Lifecycle year</legend>
            <label for="launch-year-filter">Launch year</label>
            <select id="launch-year-filter" class="search" data-year-filter="launch_year">
              <option value="">All launch years</option>
              {options.launchYears.map((year:string) => <option value={year}>{year}</option>)}
            </select>
            <label for="end-year-filter">End year</label>
            <select id="end-year-filter" class="search" data-year-filter="end_year">
              <option value="">All end years</option>
              {options.endYears.map((year:string) => <option value={year}>{year}</option>)}
            </select>
          </fieldset>

          {lifecycleOptions.length > 0 &&
            <fieldset class="filter-group">
              <legend>Lifecycle relationships</legend>
              {lifecycleOptions.map(([value,label]) => <label class="check"><input type="checkbox" data-filter="lifecycle" value={value}/><span>{label}</span><em>{counts.lifecycle[value] ?? 0}</em></label>)}
            </fieldset>
          }

          {evidenceOptions.length > 0 &&
            <fieldset class="filter-group">
              <legend>Evidence / review state</legend>
              {evidenceOptions.map(([value,label]) => <label class="check"><input type="checkbox" data-filter="evidence" value={value}/><span>{label}</span><em>{counts.evidence[value] ?? 0}</em></label>)}
            </fieldset>
          }

          <button class="btn" data-clear-filters type="button">Clear filters</button>
        </details>
      </aside>
      <section class="catalog-panel framed-panel encyclopedia-catalog">
        <div class="catalog-toolbar encyclopedia-toolbar">
          <p><strong data-result-count>{records.length}</strong> results</p>
          <div class="filter-pills" data-active-filter-summary><span>All records</span></div>
          <a class="text-link" href="/tokenized-collectibles/">Tokenized Collectibles guide →</a>
          <span class="view-icons" aria-hidden="true">▦ ☰</span>
        </div>
        <div class="grid cards catalog-grid encyclopedia-grid" data-card-list>
          {records.map((record) => <EncyclopediaCard record={record} filterMeta={metaById.get(record.id)} />)}
        </div>
        <div class="load-more-wrap" data-load-more-wrap>
          <button class="btn" data-load-more type="button">Load more records</button>
          <p class="subtle" data-load-more-status></p>
        </div>
        <div class="card empty" data-empty-state><h3>No matching records</h3><p>Clear filters or try a broader search.</p></div>
      </section>
      <aside class="field-notes-panel framed-panel encyclopedia-notes">
        <p class="eyebrow">Field notes</p><h2>{selected.canonical_name}</h2><p>{selected.summary}</p>
        <div class="specimen-plate" aria-hidden="true">◉</div>
        <dl class="notes-list"><div><dt>Status</dt><dd><StatusChip status={selected.status} /></dd></div><div><dt>Years active</dt><dd>{formatYearRange(selected)}</dd></div><div><dt>Chain</dt><dd>{selected.chain_scope.join(', ')}</dd></div><div><dt>Category</dt><dd>{formatCategory(selected.category)}</dd></div><div><dt>Archive state</dt><dd>{selected.archived_url ? 'Archive present' : 'Record remains'}</dd></div></dl>
        <a class="btn primary wide" href={`/encyclopedia/${selected.slug}/`}>View full record →</a>
        <blockquote>Even when the lights go out, the record remains.</blockquote>
      </aside>
    </div>
  </div>
  <script>
    const root = document.querySelector('[data-filter-root]');
    if (root) {
      const input = root.querySelector('[data-search-input]');
      const checks = [...root.querySelectorAll('input[type="checkbox"][data-filter]')];
      const yearSelects = [...root.querySelectorAll('select[data-year-filter]')];
      const cards = [...root.querySelectorAll('.marketplace-card')];
      const count = root.querySelector('[data-result-count]');
      const empty = root.querySelector('[data-empty-state]');
      const loadWrap = root.querySelector('[data-load-more-wrap]');
      const loadButton = root.querySelector('[data-load-more]');
      const loadStatus = root.querySelector('[data-load-more-status]');
      const filterDetails = root.querySelector('.encyclopedia-filter details');
      const filterSummary = root.querySelector('[data-active-filter-summary]');
      const filterNames = ['status', 'category', 'chain', 'closure_reason', 'lifecycle', 'evidence'];

      const mobileQuery = window.matchMedia('(max-width: 720px)');
      const getInitialLimit = () => mobileQuery.matches ? 30 : 60;
      const getIncrement = () => mobileQuery.matches ? 30 : 60;

      let visibleLimit = getInitialLimit();
      let wasMobile = mobileQuery.matches;

      const syncFilterDetailsState = () => {
        if (!filterDetails) return;
        if (mobileQuery.matches) filterDetails.removeAttribute('open');
        else filterDetails.setAttribute('open', '');
      };

      syncFilterDetailsState();

      const initialParams = new URLSearchParams(window.location.search);
      const initialSearch = initialParams.get('q') || initialParams.get('search');
      if (initialSearch) input.value = initialSearch;

      filterNames.forEach((name) => {
        const selectedValues = initialParams.getAll(name).flatMap((value) => value.split(',')).filter(Boolean);
        checks
          .filter((checkbox) => checkbox.dataset.filter === name && selectedValues.includes(checkbox.value))
          .forEach((checkbox) => { checkbox.checked = true; });
      });

      yearSelects.forEach((select) => {
        const value = initialParams.get(select.dataset.yearFilter);
        if (value && [...select.options].some((option) => option.value === value)) select.value = value;
      });

      const getSelectedFilters = () => {
        const selected = Object.fromEntries(filterNames.map((name) => [name, []]));
        checks.filter((checkbox) => checkbox.checked).forEach((checkbox) => {
          selected[checkbox.dataset.filter].push(checkbox.value);
        });
        return selected;
      };

      const valuesFromCard = (card, field) => (card.dataset[field] || '').split('|').filter(Boolean);

      const cardMatches = (card, query, selected) => {
        const chains = valuesFromCard(card, 'chains');
        const lifecycle = valuesFromCard(card, 'lifecycle');
        const evidenceFlags = valuesFromCard(card, 'evidenceFlags');
        const launchYear = yearSelects.find((select) => select.dataset.yearFilter === 'launch_year')?.value || '';
        const endYear = yearSelects.find((select) => select.dataset.yearFilter === 'end_year')?.value || '';

        return (
          (!query || card.dataset.search.includes(query)) &&
          (!selected.status.length || selected.status.includes(card.dataset.status)) &&
          (!selected.category.length || selected.category.includes(card.dataset.category)) &&
          (!selected.chain.length || chains.some((chain) => selected.chain.includes(chain))) &&
          (!selected.closure_reason.length || selected.closure_reason.includes(card.dataset.closure)) &&
          (!selected.lifecycle.length || lifecycle.some((value) => selected.lifecycle.includes(value))) &&
          (!selected.evidence.length || evidenceFlags.some((value) => selected.evidence.includes(value))) &&
          (!launchYear || card.dataset.launchYear === launchYear) &&
          (!endYear || card.dataset.endYear === endYear)
        );
      };

      const formatValue = (value) => value.replace(/_/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());

      const syncUrl = (query, selected) => {
        const params = new URLSearchParams();
        if (query) params.set('q', input.value.trim());
        filterNames.forEach((name) => {
          [...selected[name]].sort().forEach((value) => params.append(name, value));
        });
        yearSelects.forEach((select) => {
          if (select.value) params.set(select.dataset.yearFilter, select.value);
        });
        const suffix = params.toString();
        history.replaceState({}, '', `${window.location.pathname}${suffix ? `?${suffix}` : ''}`);
      };

      const syncSummary = (query, selected) => {
        if (!filterSummary) return;
        const labels = [];
        if (query) labels.push(`Search: ${input.value.trim()}`);
        filterNames.forEach((name) => selected[name].forEach((value) => labels.push(`${formatValue(name)}: ${formatValue(value)}`)));
        yearSelects.forEach((select) => {
          if (select.value) labels.push(`${formatValue(select.dataset.yearFilter)}: ${select.value}`);
        });
        filterSummary.innerHTML = labels.length
          ? labels.map((label) => `<span>${label}</span>`).join('')
          : '<span>All records</span>';
      };

      const update = ({ resetLimit = false, updateUrl = true } = {}) => {
        if (resetLimit) visibleLimit = getInitialLimit();

        const query = input.value.trim().toLowerCase();
        const selected = getSelectedFilters();
        let matched = 0;
        let shown = 0;

        cards.forEach((card) => {
          const matches = cardMatches(card, query, selected);
          if (matches) matched += 1;
          const shouldShow = matches && matched <= visibleLimit;
          card.classList.toggle('is-hidden', !shouldShow);
          if (shouldShow) shown += 1;
        });

        count.textContent = matched;
        empty.style.display = matched ? 'none' : 'block';
        const remaining = Math.max(matched - shown, 0);
        if (loadWrap) loadWrap.style.display = remaining ? 'grid' : 'none';
        if (loadStatus) {
          loadStatus.textContent = remaining
            ? `${shown} shown · ${remaining} more records`
            : matched ? `${shown} shown` : '';
        }

        syncSummary(query, selected);
        if (updateUrl) syncUrl(query, selected);
      };

      input.addEventListener('input', () => update({ resetLimit: true }));
      checks.forEach((checkbox) => checkbox.addEventListener('change', () => update({ resetLimit: true })));
      yearSelects.forEach((select) => select.addEventListener('change', () => update({ resetLimit: true })));

      const clearButton = root.querySelector('[data-clear-filters]');
      if (clearButton) {
        clearButton.addEventListener('click', () => {
          input.value = '';
          checks.forEach((checkbox) => { checkbox.checked = false; });
          yearSelects.forEach((select) => { select.value = ''; });
          update({ resetLimit: true });
        });
      }

      if (loadButton) {
        loadButton.addEventListener('click', () => {
          visibleLimit += getIncrement();
          update({ updateUrl: false });
        });
      }

      window.addEventListener('resize', () => {
        const isMobile = mobileQuery.matches;
        if (isMobile !== wasMobile) {
          wasMobile = isMobile;
          syncFilterDetailsState();
          update({ resetLimit: true, updateUrl: false });
        }
      });

      update({ resetLimit: true, updateUrl: false });
    }
  </script>
</BaseLayout>
