---
import BaseLayout from '../layouts/BaseLayout.astro';
const formUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSeBb4D0ljk3j1ju4lsfKiYEU8WIRu_ntn4DWar7DYMkX1B3eQ/viewform?usp=dialog';
const checklist = ['Marketplace name, aliases, original URL, and domain.', 'Source URL for launch, closure, acquisition, merge, rebrand, or current availability.', 'Archive URL when available.', 'Notes for frontend status, contract status, asset status, and where users or assets went.', 'Reason the record is a marketplace, not only a collection, gallery, or price tracker.'];
---
<BaseLayout title="Submit or correct — Minted & Gone" description="Submit missing NFT marketplace records, corrections, source links, and archive captures for Minted & Gone.">
  <div class="shell guide-page">
    <section class="field-hero simple-hero"><figure class="hero-botanical hero-page-art" aria-hidden="true"><img src="https://github.com/user-attachments/assets/2d991d0d-d837-4186-adf2-27a6b109feeb" alt="" loading="eager" /></figure><div class="hero-copy plate-copy"><p class="eyebrow">Correction desk</p><h1>Submit or correct a marketplace record</h1><div class="flourish" aria-hidden="true">✦</div><p class="lede">Send missing marketplaces, record corrections, source links, and archive captures.</p><p>Keep submissions historical, sourced, and correction-friendly. Use the contact page instead for general questions, rights concerns, or support-related messages.</p><div class="hero-actions"><a class="btn primary" href={formUrl} target="_blank" rel="noreferrer">Open submission form</a><a class="btn" href="/contact/">General contact</a></div></div></section>
    <section class="correction-desk framed-panel"><p class="eyebrow">What to include</p><h2>A good correction reads like a field note</h2><ol class="checklist">{checklist.map((item) => <li>{item}</li>)}</ol><p class="mock-note">No promotional listings. Submissions should be historical, sourced, and correction-friendly.</p><div class="hero-actions"><a class="btn primary" href={formUrl} target="_blank" rel="noreferrer">Open Google Form</a><a class="btn" href="https://github.com/badjoke-lab/mintedandgone/issues/new" target="_blank" rel="noreferrer">Open GitHub Issue</a></div></section>
    <section class="guide-grid"><article class="framed-panel definition-card"><h2>Do include</h2><p>Primary announcements, archive captures, exact status dates, successor destinations, and notes that make uncertainty easy to review.</p></article><article class="framed-panel definition-card"><h2>Do not include</h2><p>Promotional copy, unsourced rankings, price claims, wallet requests, login flows, or runtime service requirements.</p></article></section>
  </div>
</BaseLayout>
