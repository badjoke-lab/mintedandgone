---
import BaseLayout from '../layouts/BaseLayout.astro';
const checklist = ['Marketplace name, aliases, original URL, and domain.', 'Source URL for launch, closure, acquisition, merge, rebrand, or current availability.', 'Archive URL when available.', 'Notes for frontend status, contract status, asset status, and where users or assets went.', 'Reason the record is a marketplace, not only a collection, gallery, or price tracker.'];
---
<BaseLayout title="Submit or correct — Minted & Gone">
  <div class="shell guide-page">
    <section class="field-hero simple-hero"><div class="hero-botanical" aria-hidden="true">✎</div><div class="hero-copy plate-copy"><p class="eyebrow">Correction desk</p><h1>Suggest a missing marketplace</h1><div class="flourish" aria-hidden="true">✦</div><p class="lede">There is no live form in v0.</p><p>Use the placeholder channels below when this project is wired to real intake. Keep submissions historical, sourced, and correction-friendly.</p></div></section>
    <section class="correction-desk framed-panel"><p class="eyebrow">What to include</p><h2>A good correction reads like a field note</h2><ol class="checklist">{checklist.map((item) => <li>{item}</li>)}</ol><p class="mock-note">No promotional listings. Submissions should be historical, sourced, and correction-friendly.</p><div class="hero-actions"><a class="btn" href="https://example.invalid/google-form-placeholder">Google Form placeholder</a><a class="btn" href="https://example.invalid/github-issue-placeholder">GitHub Issue placeholder</a></div></section>
    <section class="guide-grid"><article class="framed-panel definition-card"><h2>Do include</h2><p>Primary announcements, archive captures, exact status dates, successor destinations, and notes that make uncertainty easy to review.</p></article><article class="framed-panel definition-card"><h2>Do not include</h2><p>Promotional copy, unsourced rankings, price claims, wallet requests, login flows, or runtime service requirements.</p></article></section>
  </div>
</BaseLayout>
