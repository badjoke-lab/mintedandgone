---
import { formatDatePrecision, formatLabel } from '../lib/format';
const { events = [] } = Astro.props;
---
<section class="record-timeline-section">
  <p class="eyebrow">Timeline</p>
  <h2>Recorded events</h2>
  <div class="timeline">
    {events.map((event:any) => (
      <article class="timeline-item timeline-entry">
        <span class="timeline-dot" aria-hidden="true"></span>
        <div class="timeline-copy">
          <h3>{event.title}</h3>
          <p class="timeline-meta">
            <strong>{formatDatePrecision(event.event_date, event.event_date_precision)}</strong>
            <span>{formatLabel(event.event_type)}</span>
            <span>confidence {event.confidence}</span>
          </p>
          <p class="timeline-description">{event.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
