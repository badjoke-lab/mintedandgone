---
const { stats } = Astro.props;
const items = [
  ['◎', 'Marketplaces', stats.kpis.total_marketplaces],
  ['◷', 'Events', stats.kpis.total_events],
  ['▤', 'Evidence', stats.kpis.total_evidence],
  ['✽', 'Active-side', stats.kpis.active_side_total],
  ['☙', 'Faded-side', stats.kpis.faded_side_total],
  ['×', 'Dead', stats.kpis.dead_total],
  ['✓', 'Source-reviewed drafts', stats.kpis.source_reviewed_draft_total],
  ['◆', 'Public-quality reviewed', stats.kpis.public_quality_reviewed_total]
];
---
<div class="home-stats-grid">
  {items.map(([icon, label, value]) => (
    <div class="home-stat-card"><span aria-hidden="true">{icon}</span><strong>{value}</strong><small>{label}</small></div>
  ))}
</div>
