---
const { stats } = Astro.props;
const k = stats.kpis;
const items = [
  ['Marketplaces', k.total_marketplaces],
  ['Events', k.total_events],
  ['Evidence notes', k.total_evidence],
  ['Active-side', k.active_side_total],
  ['Faded-side', k.faded_side_total],
  ['Dead', k.dead_total],
  ['Source-reviewed drafts', k.source_reviewed_draft_total],
  ['Public-quality reviewed', k.public_quality_reviewed_total]
];
---
<div class="kpi-grid">{items.map(([label,value]) => <div class="card kpi"><strong>{value}</strong><p>{label}</p></div>)}</div>
