---
const { record } = Astro.props;
const originalUrl = record.official_url_original;
const archivedUrl = record.archived_url;
---
<section>
  <p class="eyebrow">URL & archive</p>
  <h2>Original trail</h2>
  <div class="url-grid">
    <div class="card url-card">
      <h3>Original URL</h3>
      {originalUrl ? <p><a class="url-link" href={originalUrl} target="_blank" rel="noopener noreferrer">{originalUrl}</a></p> : <p>Unknown</p>}
      <p class="subtle">Status: {record.official_url_status || 'unknown'}</p>
    </div>
    <div class="card url-card">
      <h3>Archived URL</h3>
      {archivedUrl ? <p><a class="url-link" href={archivedUrl} target="_blank" rel="noopener noreferrer">{archivedUrl}</a></p> : <p>No archive URL in this mock record.</p>}
      <p class="subtle">Domain: {record.official_domain_original || 'unknown'}</p>
    </div>
  </div>
</section>