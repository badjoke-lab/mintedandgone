---
const { record } = Astro.props;
const originalUrl = record.official_url_original;
const archivedUrl = record.archived_url;
---
<section>
  <p class="eyebrow">URL & archive</p>
  <h2>Original trail</h2>
  <div class="url-grid">
    <div class="card url-card">
      <h3>Original URL</h3>
      <p class="url-value">{originalUrl || 'Unknown'}</p>
      {originalUrl && <a class="external-link-button" href={originalUrl} rel="noopener noreferrer">Open original site →</a>}
      <p class="subtle">Status: {record.official_url_status || 'unknown'}</p>
    </div>
    <div class="card url-card">
      <h3>Archived URL</h3>
      <p class="url-value">{archivedUrl || 'No archive URL in this mock record.'}</p>
      {archivedUrl && <a class="external-link-button archive-link-button" href={archivedUrl} rel="noopener noreferrer">Open archived site →</a>}
      <p class="subtle">Domain: {record.official_domain_original || 'unknown'}</p>
    </div>
  </div>
</section>