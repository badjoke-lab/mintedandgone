---
type GlossaryLink = {
  title: string;
  href: string;
};

const { terms = [] } = Astro.props as { terms: GlossaryLink[] };
---
{terms.length > 0 && (
  <section class="framed-panel definition-card">
    <p class="eyebrow">Related glossary terms</p>
    <h2>Key terms for this guide</h2>
    <div class="hero-actions">
      {terms.map((term) => <a class="btn" href={term.href}>{term.title}</a>)}
      <a class="btn" href="/glossary/">Glossary index</a>
    </div>
  </section>
)}
