---
import StatusChip from './StatusChip.astro';
import Tags from './Tags.astro';
import { formatCategory, formatScope, formatYearRange } from '../lib/format';
const { record } = Astro.props;
const searchText = [record.canonical_name, record.slug, record.summary, record.category, record.marketplace_scope, ...(record.chain_scope ?? [])].join(' ').toLowerCase();
---
<a class="card market-card marketplace-card" href={`/marketplace/${record.slug}/`} data-search={searchText} data-status={record.status} data-category={record.category} data-chains={(record.chain_scope ?? []).join('|')}>
  <div class="card-top"><h3>{record.canonical_name}</h3><StatusChip status={record.status} /></div>
  <div class="tag-row"><span class="tag">{formatCategory(record.category)}</span><span class="tag">{formatScope(record.marketplace_scope)}</span></div>
  <Tags items={record.chain_scope} />
  <p>{record.summary}</p>
  <div class="meta-grid" aria-label="Record metadata">
    <div class="fact"><b>Years</b>{formatYearRange(record)}</div><div class="fact"><b>Confidence</b>{record.confidence}</div>
    <div class="fact"><b>Review</b>{record.review_status}</div><div class="fact"><b>Mock note</b>layout data</div>
  </div>
</a>
