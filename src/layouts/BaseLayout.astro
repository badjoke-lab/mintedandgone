---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { getStats } from '../lib/data';

const stats = getStats();
const defaultDescription = `Minted & Gone is a historical registry of ${stats.kpis.total_marketplaces} NFT marketplaces, with ${stats.kpis.total_events} events and ${stats.kpis.total_evidence} evidence notes.`;
const {
  title = 'Minted & Gone',
  description = defaultDescription,
  image = '/og-image.svg',
  type = 'website'
} = Astro.props;

const site = Astro.site ?? new URL('https://mag.badjoke-lab.com');
const canonical = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Minted & Gone',
      url: new URL('/', site).toString(),
      description
    },
    {
      '@type': 'Dataset',
      name: 'Minted & Gone canonical NFT marketplace registry',
      description: 'Canonical marketplace, event, and evidence records used to generate the public HTML and machine-readable registry files.',
      url: new URL('/data/manifest.json', site).toString(),
      version: stats.schema_version,
      dateModified: stats.generated_at,
      isAccessibleForFree: true,
      additionalProperty: [
        { '@type': 'PropertyValue', name: 'canonical_only', value: true },
        { '@type': 'PropertyValue', name: 'marketplaces', value: stats.kpis.total_marketplaces },
        { '@type': 'PropertyValue', name: 'events', value: stats.kpis.total_events },
        { '@type': 'PropertyValue', name: 'evidence', value: stats.kpis.total_evidence }
      ],
      distribution: [
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL('/data/marketplaces.json', site).toString() },
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL('/data/events.json', site).toString() },
        { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL('/data/evidence.json', site).toString() }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/json" href="/version.json" title="MAG version metadata" />
    <link rel="alternate" type="application/json" href="/data/manifest.json" title="MAG data manifest" />
    <link rel="alternate" type="application/json" href="/data/marketplaces.json" title="MAG canonical marketplace records" />
    <link rel="alternate" type="application/json" href="/data/events.json" title="MAG canonical event records" />
    <link rel="alternate" type="application/json" href="/data/evidence.json" title="MAG canonical evidence records" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="MAG machine-readable guide" />
    <link rel="alternate" type="text/plain" href="/ai.txt" title="MAG concise machine-readable guide" />
    <meta property="og:site_name" content="Minted & Gone" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <GoogleAnalytics />
  </head>
  <body>
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
